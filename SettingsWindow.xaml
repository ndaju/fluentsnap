<ui:FluentWindow x:Class="FluentSnap.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="FluentSnap settings" Width="520" Height="590" WindowStartupLocation="CenterOwner" Background="#17181C" Foreground="#F4F6FA" ExtendsContentIntoTitleBar="False">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Settings" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Capture, shortcuts, and workspace behavior" Opacity="0.6" Margin="0,5,0,24"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Set keybind" FontWeight="SemiBold"/><TextBlock Text="Click the field, press the shortcut keys, then choose Save. Ctrl+Shift+S is recommended; Win+Shift+S opens Windows Snipping Tool." Opacity="0.6" Margin="0,4,0,8" TextWrapping="Wrap"/><TextBox x:Name="ShortcutBox" Text="{Binding CaptureShortcut, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="ShortcutBox_KeyDown" Height="38" FontSize="15" Padding="10" ToolTip="Click here and press a combination such as Ctrl+Shift+S"/>
   <TextBlock Text="Automatic save folder" FontWeight="SemiBold" Margin="0,20,0,7"/><DockPanel><TextBox Text="{Binding CaptureFolder, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8"/><ui:Button Content="Browse" Click="BrowseFolder_Click" Margin="8,0,0,0" Padding="12,6"/></DockPanel><TextBlock Text="Captures are saved here immediately after capture." Opacity="0.6" Margin="0,4,0,0"/>
   <TextBlock Text="Default capture type" FontWeight="SemiBold" Margin="0,20,0,7"/><ComboBox x:Name="ModeBox" ItemsSource="{Binding CaptureModes}" SelectedItem="{Binding DefaultMode, Mode=TwoWay}" Height="36"/>
   <CheckBox IsChecked="{Binding OpenToolbarOnShortcut, Mode=TwoWay}" Content="Open the floating capture toolbar from the shortcut" Margin="0,20,0,0"/><CheckBox IsChecked="{Binding RememberLastMode, Mode=TwoWay}" Content="Remember the last selected capture mode" Margin="0,12,0,0"/><CheckBox IsChecked="{Binding ShowTooltips, Mode=TwoWay}" Content="Show tooltips" Margin="0,12,0,0"/><CheckBox IsChecked="{Binding RestoreAfterCapture, Mode=TwoWay}" Content="Restore the main window after capture" Margin="0,12,0,0"/><CheckBox IsChecked="{Binding StartMinimized, Mode=TwoWay}" Content="Start minimized" Margin="0,12,0,0"/>
   <TextBlock x:Name="ErrorText" Foreground="#FF9B9B" TextWrapping="Wrap" Margin="0,18,0,0"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><ui:Button Content="Reset defaults" Click="Reset_Click" Margin="0,0,8,0"/><ui:Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/><ui:Button Content="Save" Background="#2563EB" BorderBrush="#60A5FA" Click="Save_Click"/></StackPanel>
 </Grid>
</ui:FluentWindow>
