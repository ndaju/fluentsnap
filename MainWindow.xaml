<ui:FluentWindow x:Class="FluentSnap.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:FluentSnap"
 Title="FluentSnap" Width="1120" Height="760" MinWidth="800" MinHeight="560"
 Background="#17181C" Foreground="#F4F6FA" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" ExtendsContentIntoTitleBar="True">
 <Grid>
  <Grid.Resources>
   <Style TargetType="ToolTip"><Setter Property="Opacity" Value="0"/><Style.Triggers><EventTrigger RoutedEvent="ToolTip.Opened"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></EventTrigger></Style.Triggers></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="58"/><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="#24252B" BorderBrush="#3B3D45" BorderThickness="0,0,0,1" Padding="18,0">
   <DockPanel LastChildFill="False">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="28" Height="28" CornerRadius="8" Background="#2563EB"><Image x:Name="BrandMark" Width="28" Height="28" Stretch="Uniform"/></Border>
     <StackPanel Margin="11,0,0,0"><TextBlock Text="FluentSnap" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Capture workspace" FontSize="11" Opacity="0.55"/><TextBlock x:Name="CaptureLocationText" Text="No screenshot saved yet" FontSize="10" Opacity="0.5" MaxWidth="420" TextTrimming="CharacterEllipsis" ToolTip="Latest screenshot file location"/></StackPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <ui:Button Content="Open" Click="Open_Click" ToolTip="Open an image (Ctrl+O)" Margin="4,0,10,0" Padding="14,8"/>
     <ui:Button Click="GitHub_Click" ToolTip="Open FluentSnap on GitHub" Margin="0,0,10,0" Padding="12,8"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Code24" Margin="0,0,6,0"/><TextBlock Text="GitHub"/></StackPanel></ui:Button>
     <ui:Button Click="Settings_Click" ToolTip="Settings" Margin="0,0,10,0" Padding="12,8"><ui:SymbolIcon Symbol="Settings24"/></ui:Button>
     <ui:Button Content="Save" Click="Save_Click" ToolTip="Save as PNG (Ctrl+S)" Margin="0,0,14,0" Padding="14,8"/>
     <ui:Button Click="Minimize_Click" ToolTip="Minimize" Margin="0,0,6,0"><ui:SymbolIcon Symbol="Subtract24"/></ui:Button>
     <ui:Button Click="Maximize_Click" ToolTip="Maximize" Margin="0,0,6,0"><ui:SymbolIcon Symbol="Maximize24"/></ui:Button>
     <ui:Button Click="Close_Click" ToolTip="Close" Margin="0"><ui:SymbolIcon Symbol="Dismiss24"/></ui:Button>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" Background="#1E1F24" BorderBrush="#363841" BorderThickness="0,0,0,1" Padding="14,10">
   <DockPanel LastChildFill="False">
    <StackPanel x:Name="EditorTools" Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
      <ui:Button Click="Pen_Click" ToolTip="Pen" ToolTipService.InitialShowDelay="250" ToolTipService.Placement="Bottom" Margin="0,0,6,0"><ui:SymbolIcon Symbol="Edit24"/></ui:Button>
      <ui:Button Click="Highlighter_Click" ToolTip="Highlighter" ToolTipService.InitialShowDelay="250" ToolTipService.Placement="Bottom" Margin="0,0,6,0"><ui:SymbolIcon Symbol="Highlight24"/></ui:Button>
      <ui:Button Click="Crop_Click" ToolTip="Crop" ToolTipService.InitialShowDelay="250" ToolTipService.Placement="Bottom" Margin="0,0,6,0"><ui:SymbolIcon Symbol="Crop24"/></ui:Button>
      <ui:Button Click="Undo_Click" ToolTip="Undo" ToolTipService.InitialShowDelay="250" ToolTipService.Placement="Bottom" Margin="0,0,6,0"><ui:SymbolIcon Symbol="ArrowUndo24"/></ui:Button>
      <ui:Button Click="Redo_Click" ToolTip="Redo" ToolTipService.InitialShowDelay="250" ToolTipService.Placement="Bottom"><ui:SymbolIcon Symbol="ArrowRedo24"/></ui:Button>
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <ui:Button Content="Fit" Click="Fit_Click" ToolTip="Fit image to workspace" Padding="13,8" Margin="4,0"/>
     <ui:Button Content="Copy" Click="Copy_Click" ToolTip="Copy image to clipboard" Padding="13,8" Margin="4,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2" Background="#111216">
   <Border x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="58,48" Background="#24252B" CornerRadius="14" BorderBrush="#3C3E47" BorderThickness="1">
    <StackPanel><TextBlock Text="Capture what matters" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Use your shortcut to open the capture menu." Opacity="0.62" Margin="0,12,0,8" HorizontalAlignment="Center"/><TextBlock x:Name="ShortcutHint" FontSize="15" FontWeight="SemiBold" Foreground="#60A5FA" HorizontalAlignment="Center"/></StackPanel>
   </Border>
   <local:ImageEditor x:Name="Editor" Visibility="Collapsed"/>
  </Grid>
  <Border Grid.Row="3" Background="#24252B" Padding="18,0"><TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Opacity="0.62" FontSize="12"/></Border>
 </Grid>
</ui:FluentWindow>

